function mol() { command /home/$USER/newbin/molden -l -S "$@".out >& /dev/null & }
function qf() { command qstat -f "$@" | command grep exec_host; }
function rwf() { command ssh "$@" 'rm -rf /tmp/r*'; }
function catrwf() { command cat "$@".g98.out | command grep node; }
function qc() { command qstat -a |grep -v '0 Q ' |grep -c "$@" ;}
function qc2() { command qstat -a |egrep -v '0 E |0 Q ' |grep -c "$@" ;}
function xyz() { command awk -f ~/newbin/extract-xyz-g03.awk "$@".out ;}
function xyz-freq() { command awk -f ~/newbin/prog-freq-coords.awk "$@" ;}
function xyz-no-freq() { command awk -f ~/bin/extract-xyz-g03-no-freq.awk "$@".out ;}
function zpe() { command pwd; command grep 'Done' "$@".out |command tail -n 1; command grep 'Sum of e' "$@".out ; command grep 'arning' "$@".out  | grep -v 'arning -- This'; command grep "imag" "$@".out ; command grep -m 1 "NBasis" "$@".out ; }
function eigen() { command egrep 'Done|YES| NO |     Eigenvalues ---   -' "$@".out |more;}
function eigen09() { command awk -f ~/bin/eigen.awk 1.out |more;}
function peigen() { command egrep 'extrapolated|YES| NO |     Eigenvalues ---    -' "$@".out |more;}
function scpl() { command scp *.fchk 141.225.147.5:~/"$@"; }
function xyz-mopac() { command awk -f ~/bin/extract-xyz-mopac-msi.awk "$@".out ;}
function mol09() { command awk -f ~/bin/extract-molden-g09-opt.awk "$@".out > geom.mol; command /home/webster/bin/molden -l geom.mol >& /dev/null & }
function cleanfreq() { command awk -f ~/bin/prog-clean-freq.awk "$@".out > freq-clean.out;}
function cleanfreq09() { command awk -f ~/bin/prog-clean-freq-g09.awk "$@".out > freq-clean.out;}
function create-simspec() { command echo "G 20. nm" > input ; command echo "100. 900. 1." >> input ; command grep "\<nm\>" 1.out | awk '{print $9}' | grep -c f >> input ; command grep "Excited State " 1.out | awk '{print $7,$9}' | command sed 's/f=//g' >> input; ~/bin/simspec input; }
function makeonecar() { command make-car.sh ; command cerius-xyz carcoords; command scp carcoords.car 141.225.147.5:"$@"; }
function checknodes() { command mdiag -n -v | awk '{ printf "%-4s  %-10s   %-5s   %-5s   %-20s\n", $1, $2, $3, $11, $13}' | head -n -4 ; }
function xdone() { command egrep 'Step number|NIter=   |NO |YES|Predicted' "$@" ; }

