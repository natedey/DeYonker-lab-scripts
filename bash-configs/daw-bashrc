### queue checking commands ###
# slurm time format variable applies to all slurm squeue/sacct/etc functions but details seem to only exist on sinfo manual page
# see here: https://slurm.schedmd.com/sinfo.html
export SLURM_TIME_FORMAT="%d %b %H:%M"
function qs() { # qs formatted how I like it but if someone else runs it with their username it'll do the old group format that they're used to
  if [ -z "$1" ]; then 
    squeue -u "$USER" -h -t pending,running,suspended -r -o "%P %T" | uniq -c
    sacct --state=running,pending,suspended -u "$USER" -X -o jobid%-12,partition%-10,submit%-12,state%-8,start%-12,elapsed%12,timelimit%12,workdir%-120
  elif [[ "$1" == "sort" ]]; then
    squeue -u "$USER" -h -t pending,running,suspended -r -o "%P %T" | uniq -c 
    sacct --state=pending -u "$USER" -X -o jobid%-12,partition%-10,submit%-12,state%-8,start%-12,elapsed%12,timelimit%12,workdir%-120
    sacct --state=running,suspended -u "$USER" -X -o jobid%-12,partition%-10,submit%-12,state%-8,start%-12,elapsed%12,timelimit%12,workdir%-120 | awk 'NR > 1'
  else 
    squeue -u "$1" -h -t pending,running,suspended -r -O "state" | uniq -c
    sacct --state=running,pending,suspended -u "$1" -X -o state,partition,elapsed,timelimit%15,jobid%15,workdir%-120
  fi 
}
# check which jobs have finished in the last hour/day/week. test-qf.sh better because also checks for success
alias qfh='sacct -u "$USER" -X -S now-1hour -E now -s CA,CD,DL,OOM,F,TO -o end%-14,jobid%-8,state%-20,elapsed%12,workdir%-120 | (sed -u 2q; sort -k1,3)'
alias qfd='sacct -u "$USER" -X -S now-1day -E now -s CA,CD,DL,OOM,F,TO -o end%-14,jobid%-8,state%-20,elapsed%12,workdir%-120 | (sed -u 2q; sort -k1,3)'
alias qfw='sacct -u "$USER" -X -S now-1week -E now -s CA,CD,DL,OOM,F,TO -o end%-14,jobid%-8,state%-20,elapsed%12,workdir%-120 | (sed -u 2q; sort -k1,3)'

