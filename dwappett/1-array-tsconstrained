#!/bin/bash
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --partition=acomputeq
#SBATCH --time=48:00:00
#SBATCH --job-name=ORCA-tsconstrained
#SBATCH --output=f%5a/tsconstrained/slurm-%j.out
#SBATCH --error=f%5a/tsconstrained/slurm-%j.err
#SBATCH --mem=8GB
#SBATCH --array=ASTART-AEND%1

##### Specify name for input and output files #####
name=orca

#export orcadir=/home/ndyonker/src/orca_6_0_0
#echo $orcadir
#export PATH=$orcadir:$PATH
module load orca/6.1.1 
export orcadir=/opt/ohpc/pub/apps/uofm/orca/6.1.1
echo $orcadir
export PATH=$orcadir:$PATH

##### Go to submission directory #####
cd $SLURM_SUBMIT_DIR
CALCDIR=$SLURM_SUBMIT_DIR/f$(printf %05d ${SLURM_ARRAY_TASK_ID})/tsconstrained

##### Module load #####
module load openmpi/4.1.8/gcc.8.5.0/noncuda

# Define the variable RSH_COMMAND for communication 
# between nodes for starting independent calculations 
export RSH_COMMAND="/usr/bin/ssh -x"

##### What is my job ID? ##### 
echo "$SLURM_JOB_ID"

##### Information on list of nodes, n° of nodes, n° of threads, n° of tasks #####
echo "$SLURM_JOB_NODELIST"
echo "$SLURM_NNODES"
echo "$SLURM_NTASKS_PER_NODE"
echo "$SLURM_NTASKS"


##### CLEAN UP ANYTHING LEFT IN SCRATCH FROM PREVIOUS JOBS FOR THIS SYSTEM #####
for s in $(ls $CALCDIR/slurm-*.out | awk -F/ '{print $NF}' | sed "s/slurm-//; s/.out//"); do
 if [ -d /scratch/$USER/$s ]; then echo "removing previous calc directory $s from scratch"; rm -r /scratch/$USER/$s; fi
done

##### TMP scratch directory #####
export SCRATCHDIR=/scratch/$USER/$SLURM_JOB_ID/
mkdir $SCRATCHDIR
export TMPDIR=/scratch/$USER/$SLURM_JOB_ID/

cp $CALCDIR/$name.inp $SCRATCHDIR/
cp $CALCDIR/$name.hess $SCRATCHDIR/

cd $SCRATCHDIR

### Executable: Input-Output #####
$orcadir/orca $name.inp '--bind-to core:overload-allowed --use-hwthread-cpus' > $CALCDIR/$name.out

rm -rf *.tmp*
### remove other unnecessary files just for this project ###
rm $name.densities $name.densitiesinfo $name.engrad $name.bibtex $name.property.txt
###
cp $SCRATCHDIR/* $CALCDIR/
cd $SLURM_SUBMIT_DIR
rm -rf $SCRATCHDIR

